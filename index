
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>VX Cloaker</title>
<style>
html,body{
  margin:0;
  width:100%;
  height:100%;
  overflow:hidden;
}
body{
  display:flex;
  align-items:center;
  justify-content:center;
  font-family:Arial,sans-serif;
  background:#fff;
  color:#111;
  position:relative;
}
h1{
  font-size:32px;
  font-weight:600;
  z-index:2;
  margin:0;
  pointer-events:none;
}
canvas{
  position:fixed;
  inset:0;
  z-index:1;
}
</style>
</head>
<body>
<canvas id="bg"></canvas>
<h1>VX Cloaker</h1>
<script>
const c=document.getElementById('bg'),
      x=c.getContext('2d');
let w,h,p=[];

function resize(){
  w=c.width=innerWidth;
  h=c.height=innerHeight;
  p=[];
  let n=Math.min(240,Math.floor(w*h/10000));
  for(let i=0;i<n;i++){
    p.push({
      x:Math.random()*w,
      y:Math.random()*h,
      v:(Math.random()-.5)*.12
    });
  }
}
resize();
onresize=resize;

function draw(){
  x.clearRect(0,0,w,h);
  for(let a of p){
    a.y+=a.v;
    if(a.y<0)a.y=h;
    if(a.y>h)a.y=0;
    x.fillStyle='#000';
    x.fillRect(a.x,a.y,1,1);
  }
  for(let i=0;i<p.length;i++){
    for(let j=i+1;j<p.length;j++){
      let a=p[i],b=p[j],
          d=Math.hypot(a.x-b.x,a.y-b.y);
      if(d<150){
        x.beginPath();
        x.moveTo(a.x,a.y);
        x.lineTo(b.x,b.y);
        x.strokeStyle='rgba(40,40,40,.12)';
        x.lineWidth=.5;
        x.stroke();
      }
    }
  }
  requestAnimationFrame(draw);
}
draw();

function launch(raw){
  let url=raw.trim();
  if(!url)return;
  if(!/^https?:\/\//i.test(url)){
    url='https://'+url;
  }
  try{
    const u=new URL(url);
    if(!['https:','http:'].includes(u.protocol))return;
    url=u.href;
  }catch{
    return;
  }

  const win=window.open('about:blank','_blank');
  if(!win)return;

  const doc=win.document;
  doc.title='VX Cloaker';
  doc.body.style.margin='0';

  const frame=doc.createElement('iframe');
  frame.src=url;
  frame.style.cssText=
    'position:fixed;inset:0;width:100%;height:100%;border:0';
  doc.body.appendChild(frame);
}

document.addEventListener('paste',e=>{
  const t=(e.clipboardData||window.clipboardData)
    .getData('text');
  const m=t.match(
    /(?:https?:\/\/|www\.)[^\s<>"']+|(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}(?:\/[^\s<>"']*)?/
  );
  if(m){
    e.preventDefault();
    launch(m[0]);
  }
});
</script>
</body>
</html>
